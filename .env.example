# Evidence-only mode works with no environment configuration.
# Never set any of these as NEXT_PUBLIC_*.
ENGINE_PAID_ENABLED=false
OPENAI_API_KEY=
# Explicit model supporting Responses API Structured Outputs; operator selects it.
OPENAI_MODEL=
# Optional operator-managed HTTPS admission service. Must atomically enforce
# cross-instance rate, concurrency and spend reservations. See docs/backend-engine.md.
ENGINE_ADMISSION_URL=
ENGINE_ADMISSION_TOKEN=
